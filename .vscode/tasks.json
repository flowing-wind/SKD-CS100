{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: build active file",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "-c",
                "set -e; src=\"$1\"; dir=\"$2\"; name=\"$3\"; root=\"$4\"; case \"$src\" in *.c) gcc -std=c17 -g -Wall -Wextra -Wpedantic -Werror -O0 -fsanitize=undefined -fsanitize=address -Wvla -Wno-error=vla -I\"$root\" \"$src\" -o \"$dir/$name\" ;; *.cpp|*.cc|*.cxx) g++ -std=c++17 -g -Wall -Wextra -Wpedantic -Werror -O0 -fsanitize=undefined -fsanitize=address -Wvla -Wno-error=vla -I\"$root\" \"$src\" -o \"$dir/$name\" ;; *) echo '当前文件不是支持的 C/C++ 源文件' >&2; exit 2 ;; esac",
                "_",
                "${file}",
                "${fileDirname}",
                "${fileBasenameNoExtension}",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "C/C++: run active file",
            "type": "process",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "C/C++: build active file",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-fsanitize=undefined",
                "-fsanitize=address",
                "-Wvla",
                "-Wno-error=vla",
                "-O0",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}
